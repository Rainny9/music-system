{
  "info": {
    "name": "Music API Collection",
    "description": "音乐分类检索系统 API 测试集合",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_user_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/register",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"testuser\", \"password\": \"test123\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status code is 200', function() { pm.response.to.have.status(200); });",
                "pm.test('Returns user_id', function() { var json = pm.response.json(); pm.expect(json.user_id).to.exist; });"
              ]
            }
          }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/login",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"admin\", \"password\": \"admin123\"}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status code is 200', function() { pm.response.to.have.status(200); });",
                "pm.test('Returns user_id and is_admin', function() { var json = pm.response.json(); pm.expect(json.user_id).to.exist; pm.collectionVariables.set('admin_user_id', json.user_id); });"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Songs",
      "item": [
        {
          "name": "List Songs",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/songs"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status code is 200', function() { pm.response.to.have.status(200); });",
                "pm.test('Returns array', function() { var json = pm.response.json(); pm.expect(json).to.be.an('array'); });"
              ]
            }
          }]
        },
        {
          "name": "Search Songs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/songs?keyword=test",
              "host": ["{{base_url}}"],
              "path": ["api", "songs"],
              "query": [{"key": "keyword", "value": "test"}]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["pm.test('Status code is 200', function() { pm.response.to.have.status(200); });"]
            }
          }]
        },
        {
          "name": "Get Song Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/songs/1"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status code is 200 or 404', function() { pm.expect([200, 404]).to.include(pm.response.code); });"
              ]
            }
          }]
        },
        {
          "name": "Get Genres",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/genres"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status code is 200', function() { pm.response.to.have.status(200); });",
                "pm.test('Returns array', function() { var json = pm.response.json(); pm.expect(json).to.be.an('array'); });"
              ]
            }
          }]
        },
        {
          "name": "Get Ranking",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/songs/ranking"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["pm.test('Status code is 200', function() { pm.response.to.have.status(200); });"]
            }
          }]
        }
      ]
    },
